{
  "schema": 1,
  "repository": "danilfg/dicts",
  "koreader": {
    "repo": "danilfg/koreader-dicts",
    "tag": "v1.3.0",
    "expected": 74,
    "mode": "latest upstream with owned fork fallback",
    "minimum": 74
  },
  "freedict": {
    "catalog": "https://freedict.org/freedict-database.json",
    "pairs": "all",
    "discovery": "All available entries in upstream catalog are attempted (licensing verified per source TEI)."
  },
  "wikdict": {
    "dir": "https://download.wikdict.com/dictionaries/stardict/",
    "pairs": "all",
    "discovery": "All wikdict-XX-YY.zip files in the published StarDict directory are discovered automatically."
  },
  "kaikki": {
    "url": "https://kaikki.org/simplewiktionary/raw-wiktextract-data.jsonl.gz",
    "max_phrases": 100000,
    "raw_text_archive": {
      "discovery_page": "https://kaikki.org/dictionary/rawdata.html",
      "mode": "all discoverable textual editions",
      "exclude": [
        "media",
        "audio",
        "template",
        "log"
      ]
    }
  },
  "tatoeba": {
    "links": "https://downloads.tatoeba.org/exports/per_language/eng/eng-rus_links.tsv.bz2",
    "en": "https://downloads.tatoeba.org/exports/per_language/eng/eng_sentences_detailed.tsv.bz2",
    "ru": "https://downloads.tatoeba.org/exports/per_language/rus/rus_sentences_detailed.tsv.bz2",
    "max_pairs": 30000,
    "examples_per_word": 2,
    "raw_text_archive": {
      "index_url": "https://downloads.tatoeba.org/exports/",
      "mode": "full multilingual text sentence/links exports",
      "exclude": [
        "audio"
      ]
    }
  }
}
